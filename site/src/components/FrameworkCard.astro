---
import { fmtNumber } from '../lib/format'

interface Props {
  framework: {
    id: string
    name: string
    description: string
    category: string
    language: string
    version: string
    stars: number
    weeklyDownloads: number
  }
}

const { framework: fw } = Astro.props
const href = `${import.meta.env.BASE_URL}/frameworks/${fw.id}/`
---

<a
  class="card"
  href={href}
  data-category={fw.category}
  data-lang={fw.language}
  data-stars={fw.stars ?? 0}
  data-downloads={fw.weeklyDownloads ?? 0}
  data-version={fw.version || ''}
  data-name={fw.name}
>
  <div class="top">
    <h3 class="name">{fw.name}</h3>
    {fw.version && <span class="version">{fw.version}</span>}
  </div>
  <p class="desc">{fw.description}</p>
  <div class="tags">
    <span class="tag">{fw.category}</span>
    <span class="tag">{fw.language}</span>
  </div>
  <div class="metrics">
    <span class="metric">⭐ {fmtNumber(fw.stars)}</span>
    <span class="metric">⬇ {fmtNumber(fw.weeklyDownloads)}/wk</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border: 3px solid #000;
    border-radius: 4px;
    background: #fff;
    padding: 1rem 1.1rem;
    color: #000;
    text-decoration: none;
    transition: transform 0.1s;
  }
  .card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 #000;
    background: #f5f5f5;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }
  .name {
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: -0.01em;
  }
  .version {
    font-size: 0.75rem;
    font-weight: 800;
    background: #FFE600;
    padding: 0.15rem 0.5rem;
    border: 2px solid #000;
    border-radius: 3px;
    white-space: nowrap;
  }
  .desc {
    font-size: 0.8rem;
    color: #555;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tag {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border: 2px solid #000;
    border-radius: 2px;
    background: #f5f5f5;
  }
  .metrics {
    display: flex;
    gap: 0.9rem;
    margin-top: auto;
    padding-top: 0.2rem;
    border-top: 2px solid #000;
  }
  .metric {
    font-size: 0.75rem;
    font-weight: 700;
  }
</style>
