---
import Layout from '../layouts/Layout.astro'
---

<Layout title="404 — standard-libraries-now">
  <main class="container">
    <h1 class="code">404</h1>
    <p class="msg">That page doesn't exist</p>
    <a href="/" class="back">← Back to languages</a>
  </main>
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    padding: 2rem;
  }
  .code {
    font-size: 6rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    border: 4px solid #000;
    padding: 0.5rem 2rem;
    border-radius: 4px;
    background: #FFE600;
  }
  .msg {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 1rem;
    color: #555;
  }
  .back {
    margin-top: 1.5rem;
    font-weight: 700;
    color: #000;
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .back:hover {
    background: #FFE600;
  }
</style>
