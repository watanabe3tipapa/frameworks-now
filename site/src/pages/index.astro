---
import Layout from '../layouts/Layout.astro'
import { loadAllLanguages } from '../lib/data'

const languages = loadAllLanguages()
languages.sort((a, b) => a.label.localeCompare(b.label))

const statusColor: Record<string, string> = {
  stable: '#00E5FF',
  experimental: '#FFE600',
  deprecated: '#FF69B4',
}
---

<Layout title="standard-libraries-now">
  <header class="header">
    <h1 class="title">standard-libraries-now</h1>
    <p class="subtitle">Tracking standard libraries across languages</p>
  </header>

  <main class="content">
    {
      languages.map((lang) => {
        const totalModules = lang.categories.reduce((a: number, c: any) => a + c.modules.length, 0)
        return (
          <details class="lang-card">
            <summary class="lang-summary">
              <div class="card-header">
                <h2 class="lang-name">{lang.label}</h2>
                <span class="version">{lang.version}</span>
              </div>
              <p class="stats">{totalModules} modules in {lang.categories.length} categories</p>
              <div class="category-list">
                {lang.categories.map((cat: any) => (
                  <span class="cat-tag">{cat.name}</span>
                ))}
              </div>
            </summary>
            <div class="lang-body">
              {lang.categories.map((cat: any) => (
                <details class="cat-details">
                  <summary class="cat-summary">
                    <span class="cat-name">{cat.name}</span>
                    <span class="cat-count">{cat.modules.length}</span>
                  </summary>
                  <div class="module-grid">
                    {cat.modules.map((mod: any) => (
                      <a href={mod.url} target="_blank" rel="noopener" class="module-card">
                        <span class="module-name">{mod.name}</span>
                        <span class="module-desc">{mod.description}</span>
                        <span class="status" style={`background: ${statusColor[mod.status] || '#ccc'}`}>{mod.status}</span>
                      </a>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </details>
        )
      })
    }
  </main>
</Layout>

<style>
  .header {
    text-align: center;
    border-bottom: 4px solid #000;
    padding: 2rem 1.5rem;
    margin-bottom: 2rem;
  }
  .title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .subtitle {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 0.25rem;
    color: #555;
  }
  .content {
    padding: 0 1.5rem 3rem;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .lang-card {
    border: 3px solid #000;
    border-radius: 4px;
    background: #fff;
    list-style: none;
  }
  .lang-card[open] {
    background: #fafafa;
  }
  .lang-summary {
    display: block;
    padding: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  .lang-summary::-webkit-details-marker {
    display: none;
  }
  .lang-summary:hover {
    background: #f5f5f5;
  }
  .lang-card[open] .lang-summary {
    border-bottom: 2px solid #000;
    background: #f5f5f5;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .lang-name {
    font-size: 1.5rem;
    font-weight: 900;
  }
  .version {
    font-size: 0.85rem;
    font-weight: 700;
    background: #FFE600;
    padding: 0.15rem 0.5rem;
    border: 2px solid #000;
    border-radius: 3px;
  }
  .stats {
    font-size: 0.9rem;
    color: #555;
    margin-bottom: 0.75rem;
  }
  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .cat-tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border: 1.5px solid #000;
    border-radius: 2px;
    background: #f5f5f5;
  }
  .lang-body {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cat-details {
    border: 2px solid #000;
    border-radius: 3px;
    background: #fff;
    list-style: none;
  }
  .cat-details[open] {
    background: #fff;
  }
  .cat-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.9rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.95rem;
    font-weight: 800;
  }
  .cat-summary::-webkit-details-marker {
    display: none;
  }
  .cat-summary:hover {
    background: #f5f5f5;
  }
  .cat-details[open] .cat-summary {
    border-bottom: 2px solid #000;
    background: #f5f5f5;
  }
  .cat-name {
    font-size: 0.95rem;
    font-weight: 800;
  }
  .cat-count {
    font-size: 0.7rem;
    font-weight: 700;
    color: #888;
    background: #f5f5f5;
    border: 1.5px solid #000;
    border-radius: 2px;
    padding: 0.05rem 0.4rem;
  }
  .module-grid {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    padding: 0.75rem;
  }
  .module-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border: 2px solid #000;
    border-radius: 3px;
    padding: 0.6rem;
    color: #000;
    text-decoration: none;
    transition: transform 0.1s;
  }
  .module-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #000;
    background: #FFE600;
  }
  .module-name {
    font-weight: 800;
    font-size: 0.9rem;
    font-family: monospace;
  }
  .module-desc {
    font-size: 0.7rem;
    color: #555;
    line-height: 1.3;
  }
  .status {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.05rem 0.35rem;
    border: 1.5px solid #000;
    border-radius: 2px;
    margin-top: 0.15rem;
  }
</style>
