---
import Layout from '../layouts/Layout.astro'
import FrameworkCard from '../components/FrameworkCard.astro'
import { loadFrameworks } from '../lib/data'
import { fmtDateTime } from '../lib/format'

const data = loadFrameworks()
const frameworks = data.frameworks

const CATEGORIES = [
  ['frontend', 'Frontend'],
  ['fullstack', 'Full-stack'],
  ['backend', 'Backend'],
  ['static-site', 'Static Site'],
  ['mobile', 'Mobile'],
  ['desktop', 'Desktop'],
  ['styling', 'Styling'],
]

const languages = [...new Set(frameworks.map((f) => f.language).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b),
)

const SORTS = [
  ['name', 'Name'],
  ['stars', 'Stars'],
  ['downloads', 'Downloads'],
  ['version', 'Version'],
]

const sortedByName = [...frameworks].sort((a, b) => a.name.localeCompare(b.name))
---

<Layout title="frameworks-now">
  <header class="header">
    <h1 class="title">frameworks-now</h1>
    <p class="subtitle">Tracking web frameworks across languages</p>
  </header>

  <main class="content">
    <section class="stats-bar">
      <div class="stat-chip">
        <span class="stat-num">{frameworks.length}</span>
        <span class="stat-label">Frameworks</span>
      </div>
      {
        CATEGORIES.map(([id, label]) => (
          <a class="stat-chip" data-cat={id} href={`?category=${id}`}>
            <span class="stat-num">{frameworks.filter((f) => f.category === id).length}</span>
            <span class="stat-label">{label}</span>
          </a>
        ))
      }
      <div class="updated">
        Updated: {fmtDateTime(data.updatedAt)}
      </div>
    </section>

    <section class="filters">
      <div class="filter-group">
        <span class="filter-label">Language:</span>
        <a class="chip active" data-lang="" href="?">All</a>
        {
          languages.map((l) => (
            <a class="chip" data-lang={l} href={`?lang=${encodeURIComponent(l)}`}>{l}</a>
          ))
        }
      </div>
      <div class="filter-group">
        <span class="filter-label">Sort:</span>
        {
          SORTS.map(([id, label]) => (
            <a class={`chip ${id === 'name' ? 'active' : ''}`} data-sort={id} href={`?sort=${id}`}>
              {label}
            </a>
          ))
        }
      </div>
    </section>

    <p class="result-count">{frameworks.length} frameworks</p>

    <section class="grid" id="grid">
      {
        sortedByName.map((fw) => (
          <FrameworkCard framework={fw} />
        ))
      }
    </section>
  </main>
</Layout>

<script>
  const params = new URLSearchParams(location.search)
  const category = params.get('category') || ''
  const lang = params.get('lang') || ''
  const sort = params.get('sort') || 'name'

  const cards = [...document.querySelectorAll('.card')]
  const grid = document.getElementById('grid')

  function matches(card) {
    if (category && card.dataset.category !== category) return false
    if (lang && card.dataset.lang !== lang) return false
    return true
  }

  const visible = cards.filter(matches)
  visible.forEach((c) => {
    c.hidden = false
  })
  cards.forEach((c) => {
    if (!visible.includes(c)) c.hidden = true
  })

  function sortKey(card) {
    if (sort === 'stars') return -Number(card.dataset.stars || 0)
    if (sort === 'downloads') return -Number(card.dataset.downloads || 0)
    if (sort === 'version') return card.dataset.version || ''
    return card.dataset.name || ''
  }

  visible.sort((a, b) => {
    const ka = sortKey(a)
    const kb = sortKey(b)
    if (typeof ka === 'number' && typeof kb === 'number') return ka - kb
    return String(ka).localeCompare(String(kb), undefined, { numeric: true })
  })
  visible.forEach((c) => grid.appendChild(c))

  document.querySelector('.result-count').textContent = `${visible.length} frameworks`

  document.querySelectorAll('.stat-chip[data-cat]').forEach((el) => {
    el.classList.toggle('active', el.dataset.cat === category)
  })
  document.querySelectorAll('.chip[data-lang]').forEach((el) => {
    el.classList.toggle('active', el.dataset.lang === lang)
  })
  document.querySelectorAll('.chip[data-sort]').forEach((el) => {
    el.classList.toggle('active', el.dataset.sort === sort)
  })
</script>

<style>
  .header {
    text-align: center;
    border-bottom: 4px solid #000;
    padding: 2rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .subtitle {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 0.25rem;
    color: #555;
  }
  .content {
    padding: 0 1.5rem 3rem;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .stats-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.7rem;
    border: 3px solid #000;
    border-radius: 4px;
    background: #fff;
    padding: 0.9rem;
  }
  .stat-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
    border: 2px solid #000;
    border-radius: 3px;
    padding: 0.4rem 0.9rem;
    background: #f5f5f5;
    color: #000;
    text-decoration: none;
    transition: transform 0.1s;
  }
  .stat-chip:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #000;
  }
  .stat-chip.active {
    background: #FFE600;
  }
  .stat-num {
    font-size: 1.1rem;
    font-weight: 900;
  }
  .stat-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #555;
  }
  .updated {
    margin-left: auto;
    align-self: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: #555;
    padding: 0.3rem 0.6rem;
    border: 2px solid #000;
    border-radius: 3px;
    background: #00E5FF;
  }
  .filters {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .filter-label {
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #555;
    margin-right: 0.2rem;
  }
  .chip {
    font-size: 0.72rem;
    font-weight: 700;
    border: 2px solid #000;
    border-radius: 2px;
    padding: 0.15rem 0.55rem;
    background: #fff;
    color: #000;
    text-decoration: none;
    transition: transform 0.1s;
  }
  .chip:hover {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 #000;
  }
  .chip.active {
    background: #FF69B4;
    color: #fff;
  }
  .result-count {
    font-size: 0.8rem;
    font-weight: 800;
    color: #555;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
</style>
